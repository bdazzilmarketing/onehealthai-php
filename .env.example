# One Health AI Lab Calculator (Laravel). Copy to .env; never commit real values.
APP_NAME="One Health AI Lab Calculator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://onehealth.example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (PostgreSQL 15+) -------------------------------------------------
# Runtime login created by database/sql/scripts/create-app-login.sql (NOINHERIT).
DB_CONNECTION=pgsql
DATABASE_URL=postgres://onehealth_app:CHANGE_ME@localhost:5432/onehealth
DB_SSLMODE=require
# Only for `php artisan onehealth:migrate` (database owner or CREATEROLE admin).
# Keep it out of the web server's environment.
# MIGRATION_DATABASE_URL=

# The runtime login has no table privileges of its own, so Laravel's own
# stores must not use the database.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Staff authentication --------------------------------------------------------
# At least 32 random characters (openssl rand -base64 48). Signs session cookies
# and encrypts authenticator secrets: changing it signs everyone out and
# invalidates two-step sign-in set-ups.
AUTH_SECRET=
ADMIN_SITE_URL=https://onehealth.example.com
PUBLIC_SITE_URL=https://onehealth.example.com
# Optional: AUTH_BASE_URL (defaults to ADMIN_SITE_URL / PUBLIC_SITE_URL).
# AUTH_MFA_REQUIRED_ROLES=super_admin,admin

# --- Client address behind a proxy -----------------------------------------------
# none:       no forwarded address is trusted (all callers share one rate limit)
# header:     CLIENT_IP_HEADER from a proxy inside TRUSTED_PROXY_CIDRS
# cloudflare: cf-connecting-ip from a peer inside TRUSTED_PROXY_CIDRS
TRUSTED_PROXY_MODE=none
# CLIENT_IP_HEADER=x-client-ip
# TRUSTED_PROXY_CIDRS=10.0.0.0/8

# Private file storage for uploaded workbooks and internal reports: local or s3.
FILE_STORE_DRIVER=local
FILE_STORE_PATH=
FILE_STORE_S3_ENDPOINT=
FILE_STORE_S3_BUCKET=
FILE_STORE_S3_REGION=auto
FILE_STORE_S3_ACCESS_KEY_ID=
FILE_STORE_S3_SECRET_ACCESS_KEY=

# Manual "resend to Make" action in the admin panel (optional).
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# --- Email ----------------------------------------------------------------------
# smtp | graph   (log = development only, refused in production)
EMAIL_DRIVER=smtp
EMAIL_FROM="One Health Estimator <noreply@notify.onehealth.example.com>"
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true for implicit TLS on port 465; otherwise STARTTLS is required.
SMTP_USER=
SMTP_PASSWORD=
# Staging and test: only these recipients (addresses and/or @domain entries,
# comma-separated) can receive mail; anything else is refused.
# EMAIL_ALLOWED_RECIPIENTS=tester@example.com,@qa.example.com
# Microsoft Graph (app registration with Mail.Send application permission,
# ideally limited to the sender mailbox with an application access policy):
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=noreply@example.com

# --- Scheduled jobs ---------------------------------------------------------------
# Bearer secret for /api/cron/* (at least 32 characters). Unset: every call is refused.
CRON_SECRET=

# --- AI assistant ----------------------------------------------------------------
# Without a key the assistant reports itself unavailable and Manual Mode keeps working.
OPENAI_API_KEY=
# At least 32 random characters (openssl rand -base64 48). Hashes visitor and
# network identifiers for the usage limits; raw addresses are never stored.
AI_QUOTA_HASH_SECRET=
# Optional content-free QA diagnostics, off unless both are set and a request
# carries the token in x-onehealth-qa-diagnostics. Expiry: ISO 8601, at most 72 hours ahead.
# AI_QA_DIAGNOSTICS_TOKEN=
# AI_QA_DIAGNOSTICS_EXPIRES_AT=
