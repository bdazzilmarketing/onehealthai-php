# One Health AI Lab Calculator (Laravel). Copy to .env; never commit real values.
APP_NAME="One Health AI Lab Calculator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://onehealth.example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (PostgreSQL 15+) -------------------------------------------------
# Runtime login created by database/sql/scripts/create-app-login.sql (NOINHERIT).
DB_CONNECTION=pgsql
DATABASE_URL=postgres://onehealth_app:CHANGE_ME@localhost:5432/onehealth
DB_SSLMODE=require
# Only for `php artisan onehealth:migrate` (database owner or CREATEROLE admin).
# Keep it out of the web server's environment.
# MIGRATION_DATABASE_URL=

# The runtime login has no table privileges of its own, so Laravel's own
# stores must not use the database.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
